# ---- Required secrets -------------------------------------------------------
API_KEY=your_weatherapi_com_key
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_16_char_gmail_app_password
RECEIVER_EMAIL=where_alerts_go@example.com

# Monitored locations — comma separated (use `python main.py search <name>` to find valid names)
CITY=New Delhi, India

# ---- Optional thresholds (defaults shown) -----------------------------------
# HOT_THRESHOLD=35
# COLD_THRESHOLD=10
# RAIN_CHANCE_THRESHOLD=60
# SNOW_CHANCE_THRESHOLD=50
# WIND_THRESHOLD_KPH=40
# GUST_THRESHOLD_KPH=60
# AQI_THRESHOLD=150
# UV_THRESHOLD=8
# VISIBILITY_THRESHOLD_KM=2
# PRESSURE_LOW_MB=990
# PRESSURE_HIGH_MB=1030

# ---- Optional behaviour ------------------------------------------------------
# CHECK_INTERVAL_MINUTES=30
# FORECAST_DAYS=3
# ALERT_COOLDOWN_HOURS=6
# DAILY_BRIEFING_HOUR=7
# SEND_ALERTS=true

# ---- Optional SMTP overrides (Gmail defaults shown) --------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_SSL=false
